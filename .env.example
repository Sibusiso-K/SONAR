# Copy to .env for running the pipeline scripts locally. `.env` is gitignored.
# Never commit real values. In CI these same names are GitHub repository
# secrets (Settings > Secrets and variables > Actions); see docs/ARCHITECTURE.md
# for which workflow uses which.

# --- Discovery project (scripts/sonar_db.py, scripts/watch_sources.py) ---
SUPABASE_URL=https://YOUR-DISCOVERY-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=

# --- Live-site project (scripts/sync_radar.py) ---
RADAR_SUPABASE_URL=https://YOUR-LIVE-SITE-PROJECT-REF.supabase.co
RADAR_SUPABASE_SERVICE_KEY=
# Optional: target a non-default schema (e.g. the `app` mirror).
# RADAR_SUPABASE_SCHEMA=app

# --- Language model for source extraction ---
GROQ_API_KEY=

# --- Post-deploy smoke test of a protected Vercel deployment ---
# VERCEL_PROTECTION_BYPASS=
