# Copy to web/.env for local development. `.env` is gitignored.
# The VITE_ values are compiled into the browser bundle and are PUBLIC by
# design: use the project's anon/publishable key, never the service key.
VITE_SUPABASE_URL=https://YOUR-LIVE-SITE-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side only (never exposed to the browser). The assistant works with
# none of these: the built-in engine answers from the rows. Each one added
# lets a language model answer first (docs/MODELS.md).
OPENROUTER_API_KEY=
# Optional: comma-separated free models, best first. Replaces the default list.
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free
# Optional second vendor
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# ASSISTANT_PROVIDER=auto        # auto | openrouter | groq | ollama | builtin
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:3b
