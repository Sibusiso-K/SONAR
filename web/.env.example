# Copy to web/.env for local development. `.env` is gitignored.
# The VITE_ values are compiled into the browser bundle and are PUBLIC by
# design: use the project's anon/publishable key, never the service key.
VITE_SUPABASE_URL=https://YOUR-LIVE-SITE-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side only (never exposed to the browser). Needed for the assistant.
GROQ_API_KEY=
# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# ASSISTANT_PROVIDER=groq        # groq | ollama | auto
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:3b
